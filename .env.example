# Copy to .env and fill in. Consumed by docker-compose.yml and interpolated
# into config.local.jsonc at load time (DESIGN §10). NEVER commit the real .env.

# Inbound key: what Claude Code presents as ANTHROPIC_AUTH_TOKEN. Choose any
# strong random string; the proxy validates requests against it.
PROXY_INBOUND_KEY=change-me-to-a-strong-random-string

# Outbound provider credential: a long-term AWS Bedrock API key (region-agnostic
# bearer) for Bedrock Converse + Mantle + control-plane.
# OPTIONAL: leave empty to disable Bedrock entirely — the proxy then runs on
# external providers only (set at least one *API_KEY below, e.g. ZAI_API_KEY).
# Alternative: set BEDROCK_API_KEY=dev and export AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY to mint short-lived tokens instead of a long-term key.
BEDROCK_API_KEY=

# Host port to expose the proxy on (container always listens on 8787).
PORT=8787

# Claude Code model selection. The `setup` / `config-claude` commands write
# these into ~/.claude/settings.json. Two flavors below:
#   1) VIRTUAL canonical ids (active): quality tiers from config.local.jsonc's
#      "virtualModels" block (VIRTUAL_MODELS.md) — each resolves to the first
#      available candidate provider/model and failovers across keys/providers.
#   2) REAL canonical ids (commented): direct pins to one provider's model
#      (see README "Canonical model IDs"); change to any id the running proxy
#      discovers (browse the registry page).

# --- 1) Virtual-tier pins (active) -----------------------------------------
# Requires the matching "virtualModels" block in config.local.jsonc — uncomment
# it there (see config.example.jsonc) or define your own tiers.
ANTHROPIC_MODEL=virtual.anthropic.global.sonnet-like
ANTHROPIC_DEFAULT_MODEL=virtual.anthropic.global.sonnet-like
ANTHROPIC_DEFAULT_SONNET_MODEL=virtual.anthropic.global.sonnet-like
ANTHROPIC_DEFAULT_HAIKU_MODEL=virtual.anthropic.global.haiku-like
# ANTHROPIC_DEFAULT_OPUS_MODEL matters most on third-party providers: it is
# ALSO the target of Claude Code's automatic model fallback — pin it or
# fallbacks error against Anthropic ids the proxy doesn't serve.
ANTHROPIC_DEFAULT_OPUS_MODEL=virtual.anthropic.global.opus-like
# Subagents / agent-team teammates / workflows:
CLAUDE_CODE_SUBAGENT_MODEL=virtual.anthropic.global.haiku-like
# Extra /model-picker entry (validation skipped — any id your endpoint accepts):
# ANTHROPIC_CUSTOM_MODEL_OPTION=virtual.anthropic.global.opus-like
# ANTHROPIC_CUSTOM_MODEL_OPTION_NAME=Opus-like tier
# Display/capability metadata for pinned aliases on third-party gateways:
# ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=Qwen 3.8 Max
# ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES=thinking,effort

# --- 2) Real-model pins (commented) ----------------------------------------
# ANTHROPIC_MODEL=zai.anthropic.global.glm-5.3
# ANTHROPIC_DEFAULT_MODEL=zai.anthropic.global.glm-5.3
# ANTHROPIC_DEFAULT_SONNET_MODEL=zai.anthropic.global.glm-5.3
# ANTHROPIC_DEFAULT_HAIKU_MODEL=zai.anthropic.global.glm-5.3-flash
# ANTHROPIC_DEFAULT_OPUS_MODEL=alibaba.anthropic.ap-southeast-1.qwen3.8-max-0902
# CLAUDE_CODE_SUBAGENT_MODEL=zai.anthropic.global.glm-5.3-flash
# Bedrock flavor:
# ANTHROPIC_MODEL=bedrock.mantle.us.zai.glm-5
# ANTHROPIC_DEFAULT_SONNET_MODEL=bedrock.mantle.us.zai.glm-5

# NOTE: ANTHROPIC_SMALL_FAST_MODEL is DEPRECATED upstream in favor of
# ANTHROPIC_DEFAULT_HAIKU_MODEL; `config-claude` still reads it as a legacy
# fallback (and writes it only while .env carries it) for older Claude Code
# versions. Prefer the HAIKU pin above.
# ANTHROPIC_SMALL_FAST_MODEL=zai.anthropic.global.glm-5.3-flash

# Context window (tokens) of the selected model, propagated by `setup` /
# `config-claude` into ~/.claude/settings.json as CLAUDE_CODE_MAX_CONTEXT_TOKENS.
# Claude Code only knows the window of Anthropic's own models; for any proxied
# non-Claude model it assumes 200k and warns ("... is not a model this version
# of Claude Code recognizes"). Set this to the model's real window so auto-
# compaction doesn't trim prematurely (e.g. GLM-5.3 = 1000000). Optional —
# leave unset/blank to keep Claude Code's 200k default.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000

# LAN IPv4 to publish the proxy on. The container port is bound ONLY to this
# host address (plus 127.0.0.1), never 0.0.0.0 — so the proxy is reachable on
# your LAN and locally, but cannot be exposed on any other interface (VPN,
# virtual). LEAVE BLANK to auto-derive: `setup`/`up` picks your machine's LAN
# IPv4 (RFC-1918, physical interface, excluding VPN/virtual NICs) and writes it
# back here. Set it explicitly only to override the auto-derived value.
BIND_IP=

# Run the container as your host user so the Config UI can rewrite the
# bind-mounted config.local.jsonc and write ./logs. Set to your `id -u`/`id -g`.
# (Named HOST_UID/HOST_GID because UID is a read-only shell variable.)
HOST_UID=1000
HOST_GID=1000

# External provider credentials (optional — a provider activates automatically
# once its key is set here AND it is listed in config.local.jsonc; the shipped
# config lists zai + deepseek with empty defaults, so setting ZAI_API_KEY alone
# activates z.ai). Interpolated at load time; changes need a restart (or a
# config-UI reload). This list is the canonical provider-variable set — it
# matches the env block in docker-compose.yml exactly. Keep the three sources
# (.env, .env.example, docker-compose.yml) in sync.
# DEEPSEEK_API_KEY=            # DeepSeek (native Anthropic endpoint)
ZAI_API_KEY=                   # z.ai / GLM (native Anthropic endpoint)
# z.ai credential pool (VIRTUAL_MODELS.md): request-time failover walks these
# in order when the provider's config uses a `credentials` list. All optional.
# ZAI_API_KEY_SECONDARY=       # z.ai failover key #2
# ZAI_API_KEY_TERTIARY=        # z.ai failover key #3
# GEMINI_API_KEY=              # Google Gemini (OpenAI-compatible)
# DASHSCOPE_API_KEY_INTL=      # Alibaba / Qwen — International (dashscope-intl)
# DASHSCOPE_WORKSPACE_ID_INTL= # Alibaba Singapore workspace id (token plan)
# DASHSCOPE_API_KEY_EU=        # Alibaba / Qwen — EU (Frankfurt) workspace
# DASHSCOPE_WORKSPACE_ID_EU=   # Alibaba / Qwen — EU workspace id (host template)
# EUROUTER_API_KEY=            # EUrouter (EU data-residency, OpenAI-compatible)
# MISTRAL_API_KEY=             # Mistral (OpenAI-compatible)
# MOONSHOT_API_KEY=            # Moonshot / Kimi (native Anthropic endpoint)
