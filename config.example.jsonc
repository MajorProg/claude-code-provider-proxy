{
  // claude-code-provider-proxy configuration (DESIGN §10)
  // Copy to config.local.jsonc and fill in secrets, or use ${ENV} interpolation.
  "server": { "host": "127.0.0.1", "port": 8787 },

  // Inbound auth: keys Claude Code presents via ANTHROPIC_AUTH_TOKEN (DESIGN §8.1)
  // If PROXY_INBOUND_KEY is unset the server still boots: it mints an EPHEMERAL
  // key, prints it once at boot (and shows a marker in /status.json) — the key
  // changes on every restart until you set a persistent one.
  "inboundAuth": {
    "keys": ["${PROXY_INBOUND_KEY}"]
  },

  // "global.*" canonical ids resolve to this region; also the region with latest models
  "primaryRegion": "us",

  // global | regional | auto  (DESIGN §7.3)
  "profilePreference": "global",

  // Catalog refresh cadence (DESIGN §7.4)
  "refreshIntervalMinutes": 60,

  // Optional: retry Claude on Mantle if runtime rejects (DESIGN §5.4). Default off.
  "claudeFallbackToMantle": false,

  // Region families -> concrete AWS regions (DESIGN §5.2, §10)
  "regions": [
    { "key": "us", "awsRegion": "us-east-1" },
    { "key": "eu", "awsRegion": "eu-west-1" }
  ],

  // Provider drivers + real outbound credentials (DESIGN §8.2).
  //
  // Bedrock is OPTIONAL: "${VAR:-default}" interpolation means an UNSET or
  // EMPTY env var resolves to the (empty) default instead of failing the
  // config — an empty/placeholder credential disables Bedrock and the proxy
  // runs on external providers only. Set BEDROCK_API_KEY in .env to enable it.
  "providers": {
    "bedrock": {
      "credential": "${BEDROCK_API_KEY:-}",
      "hosts": {
        "converse": "bedrock-runtime.{region}.amazonaws.com",
        "mantle": "bedrock-mantle.{region}.api.aws",
        "control": "bedrock.{region}.amazonaws.com"
      }
    },

    // External (non-Bedrock) providers. Each is keyed by provider id and
    // discriminated by "type":
    //   - "anthropic": native Anthropic Messages endpoint (passthrough path).
    //   - "openai":    OpenAI Chat Completions endpoint (mantle translation).
    // "auth" is the outbound header style ("x-api-key" or "bearer").
    // "baseUrl" omits the trailing /v1/messages or /chat/completions.
    // "countTokens": true only if the upstream supports Anthropic count_tokens.
    // "modelsUrl" is an OpenAI-style /models discovery endpoint — model IDs are
    // fetched from it at RUNTIME (no model ids in source or config), then
    // addressable as <provider>.<backend>.global.<model>.
    //
    // Active by default below: a provider whose "${VAR:-}" credential resolves
    // empty is simply SKIPPED (with a warning) until its key is set in .env —
    // so dropping e.g. ZAI_API_KEY into .env is all it takes to activate z.ai.
    //
    // For providers with per-workspace/per-region hosts (e.g. Alibaba), set
    // "hostTemplate" ({workspaceId}/{region} placeholders) + "workspaceId" +
    // "region" + "basePath" instead of "baseUrl".
    "zai": {
      "type": "anthropic",
      // Credential pool (docs/VIRTUAL_MODELS.md): request-time failover walks these
      // in order (401/403/429 or connect failure, pre-stream). Empty "${VAR:-}"
      // entries are filtered — an entirely-empty pool just skips the provider.
      "credentials": [
        { "credential": "${ZAI_API_KEY:-}", "label": "primary" },
        { "credential": "${ZAI_API_KEY_SECONDARY:-}", "label": "secondary" },
        { "credential": "${ZAI_API_KEY_TERTIARY:-}", "label": "tertiary" }
      ],
      "auth": "bearer",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "countTokens": true,
      "modelsUrl": "https://api.z.ai/api/paas/v4/models"
    },
    "deepseek": {
      "type": "anthropic",
      "credential": "${DEEPSEEK_API_KEY:-}",
      "auth": "x-api-key",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "countTokens": true,
      "modelsUrl": "https://api.deepseek.com/v1/models"
    },
    // Alibaba / Qwen — Singapore workspace (ap-southeast-1), the account
    // carrying the Token Plan. Inert until DASHSCOPE_API_KEY_INTL /
    // DASHSCOPE_WORKSPACE_ID_INTL are set in .env. Switch regions by
    // re-pointing these refs, never by editing credential values.
    "alibaba": {
      "type": "anthropic",
      "credential": "${DASHSCOPE_API_KEY_INTL:-}",
      "auth": "x-api-key",
      "hostTemplate": "{workspaceId}.{region}.maas.aliyuncs.com",
      "basePath": "/apps/anthropic",
      "workspaceId": "${DASHSCOPE_WORKSPACE_ID_INTL:-}",
      "region": "ap-southeast-1",
      "countTokens": true,
      "modelsUrl": "https://${DASHSCOPE_WORKSPACE_ID_INTL:-}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/models"
    }
    //
    // OpenAI-compatible router (EU data residency). type "openai" → the proxy
    // translates Anthropic <-> OpenAI and calls {baseUrl}/chat/completions:
    // ,"eurouter": {
    //   "type": "openai",
    //   "credential": "${EUROUTER_API_KEY}",
    //   "auth": "bearer",
    //   "baseUrl": "https://api.eurouter.ai/v1",
    //   "countTokens": false,
    //   "modelsUrl": "https://api.eurouter.ai/v1/models"
    // }
    //
    // Mistral (OpenAI-compatible):
    // ,"mistral": {
    //   "type": "openai",
    //   "credential": "${MISTRAL_API_KEY}",
    //   "auth": "bearer",
    //   "baseUrl": "https://api.mistral.ai/v1",
    //   "countTokens": false,
    //   "modelsUrl": "https://api.mistral.ai/v1/models"
    // }
    //
    // Moonshot / Kimi (native Anthropic endpoint, bearer; no count_tokens):
    // ,"moonshot": {
    //   "type": "anthropic",
    //   "credential": "${MOONSHOT_API_KEY}",
    //   "auth": "bearer",
    //   "baseUrl": "https://api.moonshot.ai/anthropic",
    //   "countTokens": false,
    //   "modelsUrl": "https://api.moonshot.ai/v1/models"
    // }
  },

  // Optional request/response logging (disabled by default). When enabled,
  // captures deduped system prompts and per-turn session files (with token
  // usage), viewable at /logs. The logs directory should be git-ignored.
  "logging": {
    "enabled": true,
    "dir": "./logs",
    "systemDir": "system",
    "sessionDir": "sessions"
  },

  // Built-in chat test page at /chat (enabled by default for a local pod). The
  // browser calls the server-side /api/chat endpoint — NO credential is ever
  // placed in the HTML. Localhost-only.
  "chatPage": { "enabled": true },

  // Virtual model tiers (docs/VIRTUAL_MODELS.md): quality-tier aliases Claude Code
  // pins its env vars to (see .env.example). Each tier resolves to the FIRST
  // currently-available candidate; on 401/403/429 or connect failure before
  // streaming starts, the proxy advances: next pool key → next candidate.
  // Candidates on providers whose keys are unset are skipped, so this block is
  // SAFE with an empty .env — tiers simply degrade to whatever is active.
  // Reorder the arrays to change provider/model priority.
  "virtualModels": {
    "sonnet-like": [
      "zai.anthropic.global.glm-5.3",
      "alibaba.anthropic.ap-southeast-1.qwen3-coder-480b-a35b-instruct",
      "bedrock.mantle.us.zai.glm-5"
    ],
    "haiku-like": [
      "zai.anthropic.global.glm-5.3-flash",
      "alibaba.anthropic.ap-southeast-1.qwen3-coder-flash",
      "bedrock.mantle.us.zai.glm-4.7-flash"
    ],
    "opus-like": [
      "alibaba.anthropic.ap-southeast-1.qwen3.8-max-0902",
      "bedrock.mantle.us.moonshotai.kimi-k2.5",
      "zai.anthropic.global.glm-5.3"
    ]
  },

  // Total upstream attempts (candidates x pool keys) per request before the
  // last error is relayed. Default 4.
  "maxFailoverAttempts": 4,

  // Audible terminal alert when the serving ACCOUNT changes (failover to the
  // next key, cooldown expiry reinstating a key, a tier shifting providers):
  // emits a BEL + "SERVING ACCOUNT CHANGED" log line — `docker compose logs -f`
  // / `bun run cli logs` pings on a terminal with audible bell enabled.
  "servingChangePing": true
}
